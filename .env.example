# Copy to .env for local development. In production set these in Railway -> Variables.
# NEVER commit real values. This file only documents the names.

NODE_ENV=production
PORT=3001

# Database (Neon / Supabase Postgres connection string)
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Supabase storage (document / image uploads)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=geoestate-docs

# Admin sign-in
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=use-a-long-random-passphrase

# Signs ALL session tokens. Use 48+ random characters:  openssl rand -hex 32
# Changing it signs every user out (that is the point of rotating it).
JWT_SECRET=generate-with-openssl-rand-hex-32

# Email (Resend)
SECRET_RESEND_API_KEY=re_your_key

# Optional
PARTNERS_JSON=[]
SECRET_FCM_SERVICE_ACCOUNT=

# --- Security switches (leave at these defaults in production) ---
# Returns OTP codes in API responses when email fails. LOCAL TESTING ONLY.
ALLOW_DEV_OTP=false
# Registration must present the verifyToken from /verify-otp. Set to false ONLY as a
# short-lived rollback if an old cached website / app build can't register yet.
ENFORCE_EMAIL_PROOF=true
