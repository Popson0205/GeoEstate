# Backend Environment Template

NODE_ENV=production
PORT=3000

# Frontend URL for CORS
FRONTEND_URL=https://geoestate.com.ng

# Supabase (see DEPLOY-ORDER.md for how to obtain these)
SUPABASE_DB_URL=postgresql://postgres.REF:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://YOURREF.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=geoestate-docs

# Admin auth
ADMIN_EMAIL=admin@geoestate.com.ng
ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=your_64_char_hex_secret_here

# Email
SECRET_RESEND_API_KEY=your_resend_api_key_here
